# Runtime
MVP_USE_MOCK_PROVIDERS=true
MVP_STORAGE_ROOT=data
MVP_STORE_BACKEND=auto
MVP_REDIS_URL=
MVP_REDIS_STATE_KEY=photo2video:state
MVP_ALLOW_BACKGROUND_TASKS=true
MVP_AUTH_ENABLED=true
AUTH_PROVIDER=local
MVP_ADMIN_USERNAME=admin
MVP_ADMIN_EMAIL=admin@studioflow.local
MVP_ADMIN_PASSWORD=admin123
MVP_AUTH_SECRET=photo2video-dev-secret
MVP_AUTH_SESSION_HOURS=24
AUTH_SESSION_DAYS=7
MVP_LOG_LEVEL=INFO
MVP_LOG_TO_FILE=true
MVP_LOCAL_ASSEMBLY_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Volc Ark Responses API
MVP_VOLC_API_KEY=
MVP_VOLC_MODEL=doubao-seed-2-0-mini
MVP_VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/responses

# KIE Sora2 API
MVP_KIE_API_KEY=
MVP_KIE_JOBS_BASE_URL=https://api.kie.ai/api/v1/jobs
MVP_KIE_MARKET_BASE_URL=https://api.kie.ai
MVP_KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
MVP_KIE_CALLBACK_URL=
MVP_KIE_VIDEO_MODEL=sora-2-image-to-video
MVP_KIE_IMAGE_MODEL=nano-banana-pro
MVP_KIE_IMAGE_RESOLUTION=1K
MVP_KIE_IMAGE_OUTPUT_FORMAT=png
MVP_STORYBOARD_CONCURRENCY=2

# Optional reference image generator (for per-shot reference images)
MVP_REF_IMAGE_ENABLED=false
MVP_REF_IMAGE_API_KEY=
MVP_REF_IMAGE_BASE_URL=
MVP_REF_IMAGE_MODEL=seedream

# Polling
MVP_POLL_INTERVAL_SECONDS=5
MVP_POLL_MAX_ATTEMPTS=180

# VL timeout and fallback
MVP_VL_OVERALL_TIMEOUT_SECONDS=90

# OSS persistence (optional, recommended for production)
MVP_OSS_ACCESS_KEY=
MVP_OSS_SECRET_KEY=
MVP_OSS_BUCKET=
MVP_OSS_REGION=oss-cn-hangzhou
MVP_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
MVP_OSS_PUBLIC_DOMAIN=
MVP_OSS_ROOT_PREFIX=photo2video
